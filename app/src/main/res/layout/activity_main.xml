<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/back"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- コピーここから -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/menu_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="なまえ"
            android:textSize="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 戻るボタン要らないならgoneしてください -->
        <Button
            android:id="@+id/button_menu1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="戻る(仮)"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="10dp"/>

        <!-- メニュー2を開くボタン -->
        <Button
            android:id="@+id/button_menu2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="メニュー"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu2"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:visibility="gone"
        android:background="@color/menu2_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/menu">

        <Button
            android:id="@+id/button_menu3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ユーザー登録"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_menu4"/>
        <Button
            android:id="@+id/button_menu4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="検索"
            app:layout_constraintTop_toTopOf="@+id/button_menu3"
            app:layout_constraintStart_toEndOf="@+id/button_menu3"
            app:layout_constraintEnd_toStartOf="@+id/button_menu5"/>
        <Button
            android:id="@+id/button_menu5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="投稿作成"
            app:layout_constraintTop_toTopOf="@+id/button_menu3"
            app:layout_constraintStart_toEndOf="@id/button_menu4"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/menu"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- メイン部分入れる場所 -->

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- コピーここまで -->

</androidx.constraintlayout.widget.ConstraintLayout>